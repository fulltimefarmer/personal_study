# ============================================================
# AI Shopping Assistant - 本地开发配置模板
# 复制为 .env 后按需修改；.env.local 会覆盖 .env
# ============================================================

# ---------- 模型提供方 ----------
# auto: 有有效 DeepSeek Key 用云端，否则自动回退本地 Ollama
# ollama: 始终使用本地 Ollama
# deepseek: 始终使用 DeepSeek（必须配置 DEEPSEEK_API_KEY）
LLM_PROVIDER=auto

# Ollama 本地模型（Windows/macOS 通用）
LLM_MODEL=qwen2.5:3b
ROUTER_MODEL=qwen2.5:3b
OLLAMA_VL_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=-1

# 简单问题本地回答，复杂问题走 Agent
USE_LOCAL_FOR_SIMPLE=true

# DeepSeek 远程 API（可选；留空则自动用 Ollama）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VL_MODEL=deepseek-v4-flash

# ---------- Embedding ----------
# hash: 零依赖本地哈希向量（默认，开箱即用）
# ollama: 使用 bge-m3，检索质量更好，需要先 ollama pull bge-m3:latest
EMBED_PROVIDER=hash
EMBED_MODEL=bge-m3:latest
EMBED_DIMENSIONS=1024

# ---------- 数据与向量库 ----------
PRODUCT_CSV_PATH=./files/products.csv
CHROMA_PERSIST_DIR=./db/chroma
CHROMA_COLLECTION=lego_products

# ---------- 关系数据库 ----------
# 默认 SQLite，零配置；需要 PostgreSQL 时改成：
# DATABASE_URL=postgresql://user:password@localhost:5432/shopping_bot
DATABASE_URL=sqlite:///./db/shopping_bot.sqlite3

# ---------- Neo4j 知识图谱（可选） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---------- 网络搜索（可选） ----------
# 留空时 web_search 工具降级，不影响商品检索
TAVILY_API_KEY=

# ---------- 运行参数 ----------
DEBUG=true
TOP_K=4
LLM_REQUEST_TIMEOUT=60
TOOL_CALL_TIMEOUT=30
